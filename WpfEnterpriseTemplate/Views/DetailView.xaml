<UserControl x:Class="WpfEnterpriseTemplate.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">

    <!--
    Vue de détail d'un utilisateur.
    Affiche toutes les informations de l'utilisateur sélectionné.
    La navigation avec paramètre permet de recevoir le UserViewModel.
    Aucun code métier dans le code-behind.
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Titre et bouton retour -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu détaillé -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec titre et bouton retour -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="Retour"
                    Command="{Binding GoBackCommand}"
                    DockPanel.Dock="Left"
                    Padding="15,8"
                    Background="#95A5A6"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <TextBlock Text="{Binding PageTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </DockPanel>

        <!-- Carte de détail de l'utilisateur -->
        <Border Grid.Row="1"
                Background="#FAFAFA"
                BorderBrush="#BDC3C7"
                BorderThickness="1"
                CornerRadius="8"
                Padding="25"
                VerticalAlignment="Top">

            <StackPanel DataContext="{Binding User}">

                <!-- Nom complet -->
                <TextBlock Text="Nom complet"
                           Foreground="#95A5A6"
                           FontSize="11"
                           Margin="0,0,0,3"/>
                <TextBlock Text="{Binding Name}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,15"/>

                <!-- Séparateur -->
                <Separator Margin="0,0,0,15"/>

                <!-- Grille d'informations détaillées -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nom d'utilisateur -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,15">
                        <TextBlock Text="Nom d'utilisateur"
                                   Foreground="#95A5A6"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                   FontSize="16"
                                   Foreground="#2C3E50"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                        <TextBlock Text="Email"
                                   Foreground="#95A5A6"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Email}"
                                   FontSize="16"
                                   Foreground="#3498DB"/>
                    </StackPanel>

                    <!-- Téléphone -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,15">
                        <TextBlock Text="Téléphone"
                                   Foreground="#95A5A6"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Phone}"
                                   FontSize="16"
                                   Foreground="#2C3E50"/>
                    </StackPanel>

                    <!-- Site web -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                        <TextBlock Text="Site web"
                                   Foreground="#95A5A6"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Website}"
                                   FontSize="16"
                                   Foreground="#3498DB"/>
                    </StackPanel>

                    <!-- ID -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Identifiant"
                                   Foreground="#95A5A6"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Id}"
                                   FontSize="16"
                                   Foreground="#7F8C8D"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
