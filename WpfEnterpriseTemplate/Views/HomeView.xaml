<UserControl x:Class="WpfEnterpriseTemplate.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="750">

    <!--
    Vue d'accueil de l'application.
    Affiche la liste des utilisateurs et les boutons d'action.
    Supporte les appels vers l'API locale (.NET 10) avec fallback JSONPlaceholder.
    DataContext est automatiquement défini par le DataTemplate dans App.xaml.
    Aucun code métier dans le code-behind.
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Titre de la page -->
            <RowDefinition Height="Auto"/>
            <!-- Indicateur de source API -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons d'action -->
            <RowDefinition Height="Auto"/>
            <!-- Liste des utilisateurs -->
            <RowDefinition Height="*"/>
            <!-- Barre de statut -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre de la page d'accueil -->
        <TextBlock Grid.Row="0"
                   Text="Accueil - Liste des utilisateurs"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,10"/>

        <!-- Indicateur de source de données API -->
        <Border Grid.Row="1"
                Background="#F8F9FA"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="Source : "
                           Foreground="#6C757D"
                           FontSize="12"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding DataSourceInfo}"
                           Foreground="#495057"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Zone de boutons d'action -->
        <WrapPanel Grid.Row="2"
                   Margin="0,0,0,12">

            <!-- Bouton de chargement des utilisateurs depuis l'API -->
            <!-- Désactivé automatiquement quand IsBusy est true (via CanExecute) -->
            <Button Content="Charger les utilisateurs"
                    Command="{Binding LoadUsersCommand}"
                    Padding="15,8"
                    Margin="0,0,8,4"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- Bouton de navigation vers le détail -->
            <!-- Désactivé si aucun utilisateur n'est sélectionné -->
            <Button Content="Voir le détail"
                    Command="{Binding NavigateToDetailCommand}"
                    Padding="15,8"
                    Margin="0,0,8,4"
                    Background="#2ECC71"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- Bouton d'ajout d'un utilisateur test (API locale uniquement) -->
            <Button Content="Ajouter un utilisateur"
                    Command="{Binding AddUserCommand}"
                    Padding="15,8"
                    Margin="0,0,8,4"
                    Background="#9B59B6"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- Bouton de suppression de l'utilisateur sélectionné (API locale uniquement) -->
            <Button Content="Supprimer la sélection"
                    Command="{Binding DeleteUserCommand}"
                    Padding="15,8"
                    Margin="0,0,8,4"
                    Background="#E74C3C"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- Indicateur de chargement visible uniquement quand IsBusy est true -->
            <TextBlock Text="Chargement en cours..."
                       VerticalAlignment="Center"
                       Foreground="#E67E22"
                       FontStyle="Italic"
                       Margin="8,0,0,4"
                       Visibility="{Binding ApplicationState.IsBusy,
                                    Converter={StaticResource BoolToVisConverter}}"/>
        </WrapPanel>

        <!-- Liste des utilisateurs avec DataTemplate pour l'affichage -->
        <ListView Grid.Row="3"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  BorderThickness="1"
                  BorderBrush="#BDC3C7">

            <ListView.ItemTemplate>
                <!-- DataTemplate définissant l'affichage de chaque UserViewModel -->
                <DataTemplate>
                    <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#ECF0F1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Identifiant de l'utilisateur -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Id, StringFormat='#{0}'}"
                                       FontWeight="Bold"
                                       Foreground="#7F8C8D"
                                       VerticalAlignment="Center"/>

                            <!-- Nom et pseudo -->
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                           Foreground="#95A5A6"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Email -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Email}"
                                       Foreground="#3498DB"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Barre de statut en bas -->
        <Border Grid.Row="4"
                Background="#ECF0F1"
                Padding="10,8"
                Margin="0,10,0,0"
                CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#7F8C8D"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
