<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WpfEnterpriseTemplate</RootNamespace>
    <AssemblyName>WpfEnterpriseTemplate</AssemblyName>
    <StartupObject>WpfEnterpriseTemplate.App.App</StartupObject>
  </PropertyGroup>

  <!--
  App.xaml est dans le sous-dossier App/ et non à la racine du projet.
  Le SDK WPF ne le détecte pas automatiquement comme ApplicationDefinition
  (il le traite comme Page par défaut). On doit le déclarer explicitement
  pour que le compilateur XAML génère la méthode Main() statique.
  -->
  <ItemGroup>
    <Page Remove="App\App.xaml" />
    <ApplicationDefinition Include="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

</Project>
