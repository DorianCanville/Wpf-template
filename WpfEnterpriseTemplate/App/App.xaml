<Application x:Class="WpfEnterpriseTemplate.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WpfEnterpriseTemplate.Views"
             xmlns:viewModels="clr-namespace:WpfEnterpriseTemplate.Core.ViewModels"
             xmlns:infra="clr-namespace:WpfEnterpriseTemplate.Infrastructure"
             ShutdownMode="OnMainWindowClose">

    <!--
    Point d'entrée XAML de l'application.
    Définit les ressources globales :
    - Convertisseurs de valeurs (BooleanToVisibility)
    - DataTemplates pour le mapping automatique ViewModel → View

    Le démarrage de l'application est géré dans App.xaml.cs (OnStartup)
    car il nécessite la configuration du conteneur DI avant l'affichage.
    StartupUri n'est donc pas utilisé.
    -->

    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== CONVERTISSEURS ===== -->
            <!-- Convertisseur booléen vers Visibility, utilisé pour IsBusy -->
            <infra:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

            <!-- ===== DATA TEMPLATES ===== -->
            <!-- Mapping automatique ViewModel → View -->
            <!-- WPF utilise ces DataTemplates pour résoudre quelle View afficher -->
            <!-- lorsqu'un ViewModel est assigné au Content d'un ContentControl -->

            <!-- HomeViewModel → HomeView -->
            <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>

            <!-- DetailViewModel → DetailView -->
            <DataTemplate DataType="{x:Type viewModels:DetailViewModel}">
                <views:DetailView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
